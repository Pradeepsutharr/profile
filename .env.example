# Database and authentication (required)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pradeep_portfolio
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-minimum-password

# Optional: Gmail inbox administration
ADMIN_GMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Required for production file uploads. Development falls back to /public/uploads.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=https://cdn.example.com
