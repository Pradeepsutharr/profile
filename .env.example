# Database and authentication (required)
# Local: local Postgres. Production (free): Neon https://console.neon.tech - use the
# pooled connection string and set DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pradeep_portfolio
DATABASE_SSL=false
SOURCE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/old_portfolio
SOURCE_UPLOAD_DIR=/absolute/path/to/old/backend/uploads
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-character-minimum-password

# Public site origin used for canonical URLs, Open Graph, sitemap, and robots.
# No trailing slash. Example: https://pradeepsuthar.com or https://your-app.vercel.app
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (from legacy profile site)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Gmail inbox administration
ADMIN_GMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Required for production file uploads (admin media / contact attachments).
# Free option: Cloudflare R2 (S3-compatible). Dev falls back to /public/uploads.
# Existing files already in public/uploads deploy with the site on Vercel.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=https://cdn.example.com

# One-time legacy data migration. Explicitly opt in before contacts and
# mailbox records are copied into the new database.
IMPORT_PRIVATE_DATA=false
